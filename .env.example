# LLM
LLM_PROVIDER=ollama                    # "ollama" or "gemini"
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Embeddings (always Ollama)
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                        # empty for local, fill for cloud

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lexara_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Langfuse (optional, leave blank to disable)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# App
APP_ENV=development                    # "development" or "production"
SECRET_KEY=change_this_to_a_random_64_char_string
MAX_UPLOAD_SIZE_MB=20
SESSION_TTL_HOURS=24

# Storage
UPLOAD_DIR=uploads                     # local dev; use R2 bucket name in production
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=